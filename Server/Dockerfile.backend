FROM node:20-alpine

WORKDIR /app

ARG NODE_ENV=development
ENV NODE_ENV=$NODE_ENV

# System setup
RUN echo "Building in $NODE_ENV mode" \
 && apk add --no-cache python3 make g++ \
 && addgroup -S appgroup \
 && adduser -S appuser -G appgroup

# Install dependencies (best caching point)
COPY package.json package-lock.json ./
RUN npm ci

# Copy application code
COPY . .

# Debugging: List files and permissions
RUN echo "Listing files in /app:" && ls -la /app
# Drop privileges
USER appuser

EXPOSE 5500
CMD ["npm","run","start"]
